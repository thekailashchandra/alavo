# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database — Neon OR self-hosted (Hostinger VPS Postgres)
# DATABASE_URL=postgresql://USER:PASSWORD@YOUR_VPS_IP:5432/alavo?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Neon Auth (Managed Better Auth) — still required until auth is migrated off Neon
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=generate_with_openssl_rand_base64_32

# Cron (email reports)
CRON_SECRET=generate_a_long_random_secret

# Web Push (VAPID)
VAPID_PUBLIC_KEY=replace_with_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_vapid_private_key
VAPID_SUBJECT_EMAIL=mailto:hi@alavo.cc
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace_with_vapid_public_key

# Email — prefer Hostinger mailbox hi@alavo.cc
EMAIL_FROM=Alavo <hi@alavo.cc>
EMAIL_REPLY_TO=hi@alavo.cc
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hi@alavo.cc
SMTP_PASSWORD=your_mailbox_password

# Optional Gmail fallback (if SMTP_* unset)
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
